                            <div class="w-1/2 h-full relative overflow-hidden">
                        @endif

                        <video x-ref="previewPlayer" 
                               :src="videoPreview"
                               @loadedmetadata="duration = Math.round($event.target.duration); durationDisplay = formatTime(duration)"
                               class="w-full h-full object-cover" muted playsinline webkit-playsinline loop autoplay></video>
                        
                        @if(isset($duetReel) && $duetReel)
                            </div>
                        @endif
                        
                        <!-- Remove Video Button -->
                        <button type="button" 
                                x-show="videoPreview" 
                                @click.stop="removeVideo()" 
                                class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/60 backdrop-blur-md text-white flex items-center justify-center transition-all hover:bg-red-500 z-30 shadow-lg border border-white/10 active:scale-90">
                            <span class="material-symbols-rounded text-base">delete</span>
                        </button>

                        <div class="absolute bottom-3 right-3 px-2 py-1 bg-black/70 backdrop-blur rounded-lg text-[9px] font-black text-white" x-text="durationDisplay"></div>
                    </div>
                    <!-- Thumbnail -->
                    <div class="bg-white dark:bg-[#121212] rounded-[2rem] border border-slate-100 dark:border-white/5 p-4 relative group/thumb">
                        <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">Cover Image</h4>
                        
                        <!-- Remove Thumbnail Button -->
                        <button type="button" 
                                x-show="thumbnailPreview" 
                                @click.stop.prevent="removeThumbnail()" 
                                class="absolute top-6 right-6 w-7 h-7 rounded-full bg-red-500 text-white flex items-center justify-center transition-all hover:bg-red-600 z-30 shadow-lg border border-white/10 active:scale-90">
                            <span class="material-symbols-rounded text-sm">close</span>
                        </button>

                        <label class="block aspect-[9/16] rounded-2xl overflow-hidden bg-slate-50 dark:bg-white/5 border-2 border-dashed border-slate-200 dark:border-white/10 cursor-pointer relative active:scale-95 transition-transform max-h-[150px]">
                            <template x-if="thumbnailPreview"><img :src="thumbnailPreview" class="w-full h-full object-cover"></template>
                            <template x-if="!thumbnailPreview">
                                <div class="flex flex-col items-center justify-center h-full text-slate-300">
                                    <span class="material-symbols-rounded text-2xl mb-1">add_photo_alternate</span>
                                    <p class="text-[8px] font-black uppercase tracking-widest">Optional</p>
                                </div>
                            </template>
                            <input type="file" name="thumbnail" class="hidden" accept="image/*" @change="onThumbnailChange">
                        </label>
                    </div>
                </div>
            </div>
            <input type="hidden" name="parent_id" :value="parentId">
        </form>
    </div>

    <!-- Music Search Modal (outside z-10 wrapper for proper stacking over camera) -->
    <div x-show="showMusicModal" x-cloak class="fixed inset-0 flex flex-col justify-end sm:items-center sm:justify-center" style="z-index: 999999;">
        <!-- Backdrop -->
        <div x-show="showMusicModal" x-transition.opacity class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="showMusicModal = false"></div>
        
        <!-- Modal Content -->
        <div x-show="showMusicModal" 
             x-transition:enter="transition ease-out duration-300" 
             x-transition:enter-start="translate-y-full sm:translate-y-4 sm:opacity-0 sm:scale-95" 
             x-transition:enter-end="translate-y-0 sm:translate-y-0 sm:opacity-100 sm:scale-100" 
             x-transition:leave="transition ease-in duration-200" 
             x-transition:leave-start="translate-y-0 sm:translate-y-0 sm:opacity-100 sm:scale-100" 
             x-transition:leave-end="translate-y-full sm:translate-y-4 sm:opacity-0 sm:scale-95" 
             class="relative w-full max-w-md bg-white dark:bg-[#1A1A1A] sm:rounded-[2rem] rounded-t-[2rem] h-[70vh] sm:h-[480px] flex flex-col shadow-2xl overflow-hidden z-10">
             
             <!-- Header -->
             <div class="px-6 py-5 border-b border-slate-100 dark:border-white/5 flex items-center justify-between shrink-0">
                 <h3 class="text-base font-black text-slate-900 dark:text-white tracking-tight">Search Music</h3>
                 <button type="button" @click="showMusicModal = false" class="w-8 h-8 rounded-full bg-slate-100 dark:bg-white/5 text-slate-500 hover:bg-slate-200 transition-colors flex items-center justify-center">
                     <span class="material-symbols-rounded text-lg">close</span>
                 </button>
             </div>

             <!-- Search Bar -->
             <div class="p-4 shrink-0 border-b border-slate-100 dark:border-white/5 bg-slate-50/50 dark:bg-black/20">
                <div class="relative group">
                    <input type="text" x-model="musicSearchQuery" @input.debounce.500ms="searchMusic()" class="w-full h-14 pl-14 pr-14 bg-white dark:bg-black/40 border border-slate-200/60 dark:border-white/5 rounded-2xl text-[13px] font-black text-slate-900 dark:text-white focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 outline-none transition-all shadow-sm" placeholder="Search millions of songs...">
                    <span class="material-symbols-rounded absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-orange-500">search</span>
                    <div x-show="searchingMusic" class="absolute right-5 top-1/2 -translate-y-1/2">
                        <div class="w-5 h-5 border-2 border-orange-500 border-t-transparent rounded-full animate-spin"></div>
                    </div>
                </div>
             </div>
             
             <!-- Results List -->
             <div class="flex-1 overflow-y-auto custom-scrollbar p-2 relative">
                 <div x-show="!searchingMusic && musicSearchResults.length === 0 && !musicSearchQuery" class="absolute inset-0 flex flex-col items-center justify-center text-center p-6 text-slate-400">
                     <span class="material-symbols-rounded text-5xl mb-3 opacity-50">library_music</span>
                     <p class="text-sm font-bold">Discover new trending tracks for your reel.</p>
                 </div>
                 <div class="grid grid-cols-1 gap-1">
                    <template x-for="song in musicSearchResults" :key="song.id">
                        <div @click="selectGlobalMusic(song); showMusicModal = false; musicSource = 'global';" 
                             :class="musicId == song.id ? 'bg-orange-500/10 border border-orange-500/20' : 'hover:bg-slate-50 dark:hover:bg-white/5 border border-transparent'"
                             class="flex items-center gap-3 p-3 rounded-xl cursor-pointer transition-all group">
                             <!-- Search result initials fallback -->
                             <div class="w-12 h-12 rounded-lg overflow-hidden shrink-0 relative bg-slate-100 dark:bg-white/5 flex items-center justify-center font-black text-slate-600 dark:text-slate-300 text-xs uppercase shadow-sm">
                                 <template x-if="song.thumbnail">
                                     <img :src="song.thumbnail" class="absolute inset-0 w-full h-full object-cover" onerror="this.style.display='none';">
                                 </template>
                                 <span x-text="getInitials(song.artist || song.title)"></span>
                             </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-[13px] font-black text-slate-900 dark:text-white truncate tracking-tight" x-text="song.title"></p>
                                <p class="text-[11px] font-bold text-slate-500 truncate tracking-wide mt-0.5" x-text="song.artist"></p>
                            </div>
                            <button type="button" @click.stop="toggleMusicPreview(song)" class="w-10 h-10 rounded-full bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0 hover:bg-orange-500 hover:text-white transition-colors shadow-sm">
                                <span class="material-symbols-rounded text-lg" x-text="previewingId == song.id ? 'pause' : 'play_arrow'"></span>
                            </button>
                        </div>
                    </template>
                </div>
             </div>
        </div>
    </div>
</div>
<style>
    [x-cloak] { display: none !important; } 
    input, select, textarea { font-size: 16px !important; }
</style>

<script src="https://cdn.jsdelivr.net/npm/tus-js-client@3.0.0/dist/tus.min.js"></script>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('reelUpload', () => ({
            step: 1,
            videoPreview: null,
            thumbnailPreview: null,
            videoFile: null,
            uploading: false,
            progress: 0,
            focused: false,
            title: @json(old('title') ?? ''),
            description: @json(old('description') ?? ''),
            location: '',
            visibility: '0',
            duration: 0,
            durationDisplay: '00:00',
            musicSource: 'none',
            musicStartTime: 0,
            musicVolume: 1.0,
            micVolume: 1.0,
            allowComments: true,
            allowDuet: true,
            allowStitch: true,
            isAgeRestricted: false,
            musicId: null,
            parentId: null,
            originalReelId: null,
            tags: [],
            tagInput: '',
            addTag() {
                let raw = this.tagInput.trim();
                if (!raw) return;
                let parts = raw.split(/[\s,]+/).map(p => p.replace(/#/g, '').trim()).filter(p => p.length > 0);
                parts.forEach(part => {
                    if (!this.tags.includes(part)) {
                        this.tags.push(part);
                    }
                });
                this.tagInput = '';
            },
            removeTag(index) {
                this.tags.splice(index, 1);
            },
            mode: 'upload', // 'upload' or 'record'
            facingMode: 'user',
            showAudioSettings: false,
            isRecording: false,
            isPaused: false,
            shouldSaveDraft: false,
            zoomSupported: false,
            zoomMin: 1,
            zoomMax: 3,
            zoomStep: 0.1,
            zoomLevel: 1,
            recordTime: 0,
             maxDuration: 15,
             durations: [15, 30, 60, 90],
            isGreenScreenActive: false,
            isBeautyActive: false,
            showFilters: false,
            activeFilter: { name: 'none', label: 'Normal', filter: 'none', preview: 'linear-gradient(135deg,#f97316,#ec4899)', icon: 'camera' },
            filters: [
                { name: 'none',       label: 'Normal',    filter: 'none',                                                                                              preview: 'linear-gradient(135deg,#f97316,#ec4899)', icon: 'camera' },
                { name: '4k',         label: '4K Ultra',  filter: 'contrast(1.15) brightness(1.05) saturate(1.1) drop-shadow(0 0 1px rgba(255,255,255,0.1))',          preview: 'linear-gradient(135deg,#000,#333)', icon: 'hd' },
                { name: 'kodak',      label: 'Kodak Gold', filter: 'sepia(0.2) saturate(1.8) contrast(1.1) brightness(1.1) hue-rotate(-5deg)',                          preview: 'linear-gradient(135deg,#f59e0b,#d97706)', icon: 'camera_roll' },
                { name: 'vintage',    label: 'Vintage',   filter: 'url(#brush-stroke) sepia(0.4) contrast(1.1) brightness(0.95)',                                      preview: 'linear-gradient(135deg,#78350f,#451a03)', icon: 'brush' },
                { name: 'frblair',    label: 'FrBlair',   filter: 'contrast(1.6) brightness(0.8) saturate(0.5) hue-rotate(-10deg)',                                     preview: 'linear-gradient(135deg,#1e1b4b,#312e81)', icon: 'filter_vintage' },
                { name: 'camcorder',  label: 'Camcorder', filter: 'contrast(1.2) brightness(1.1) saturate(0.8) hue-rotate(5deg)',                                         preview: 'linear-gradient(135deg,#4b5563,#1f2937)', icon: 'videocam', overlay: 'filter-overlay-camcorder' },
                { name: 'goodski',    label: 'Goodski',   filter: 'brightness(1.25) contrast(0.95) saturate(1.1)',                                                     preview: 'linear-gradient(135deg,#fefce8,#fef08a)', icon: 'wb_sunny' },
                { name: 'lightleak',  label: 'Light Leak', filter: 'saturate(1.2) brightness(1.1) hue-rotate(-5deg)',                                                   preview: 'linear-gradient(135deg,#f97316,#fb923c)', icon: 'flare', overlay: 'filter-overlay-lightleak' },
                { name: 'glitter',    label: 'Glitter',   filter: 'saturate(1.5) brightness(1.2) contrast(1.1)',                                                      preview: 'linear-gradient(135deg,#fff,#cbd5e1)', icon: 'auto_awesome', overlay: 'filter-overlay-glitter' },
                { name: 'oakly',      label: 'OaklyMeta', filter: 'hue-rotate(210deg) brightness(0.9) contrast(1.2) saturate(1.1)',                                      preview: 'linear-gradient(135deg,#1e40af,#1e3a8a)', icon: 'lens' },
                { name: 'glowcans',   label: 'Glow Cans', filter: 'saturate(3) contrast(1.4) brightness(1.2) hue-rotate(280deg)',                                      preview: 'linear-gradient(135deg,#c026d3,#701a75)', icon: 'energy_savings_leaf' },
                { name: 'softnature', label: 'Soft Nature', filter: 'saturate(1.5) hue-rotate(-15deg) brightness(1.05) contrast(0.95)',                                 preview: 'linear-gradient(135deg,#22c55e,#16a34a)', icon: 'eco' },
                { name: 'blogger',    label: 'Blogger',   filter: 'brightness(1.15) contrast(0.85) saturate(0.6)',                                                     preview: 'linear-gradient(135deg,#f1f5f9,#94a3b8)', icon: 'style' },
                { name: 'bigmood',    label: 'Big Mood',  filter: 'contrast(2.2) brightness(0.7) saturate(0.3)',                                                       preview: 'linear-gradient(135deg,#020617,#0f172a)', icon: 'mood_bad' },
                { name: 'cyberpunk',  label: 'Cyber',     filter: 'hue-rotate(280deg) saturate(200%) contrast(1.2) brightness(1.1)',                                   preview: 'linear-gradient(135deg,#7e22ce,#2563eb)', icon: 'cyclone' },
                { name: 'vaporwave',  label: 'Vapor',     filter: 'hue-rotate(180deg) saturate(150%) brightness(1.2) contrast(0.9)',                                   preview: 'linear-gradient(135deg,#f472b6,#38bdf8)', icon: 'waves' },
            ],
            zoomLevel: 1,
            isFlashOn: false,
            activeEffect: null,
            effects: [
                { name: 'vhs', label: 'VHS Retro', filter: 'url(#vhs-filter)', preview: 'linear-gradient(45deg, #000, #333)', icon: 'videocam' },
                { name: 'glitch', label: 'Glitch', filter: 'url(#glitch-filter)', preview: 'linear-gradient(45deg, #ff00c1, #00fff9)', icon: 'edgesensor_high' },
                { name: 'rgb', label: 'RGB Split', filter: 'url(#rgb-split)', preview: 'linear-gradient(45deg, #f00, #0f0, #00f)', icon: 'filter_b_and_w' },
                { name: 'prism', label: 'Prism', filter: 'url(#prism-filter)', preview: 'linear-gradient(135deg, #ff0, #0ff)', icon: 'flare' },
                { name: 'cyber', label: 'Cyberpunk', filter: 'hue-rotate(280deg) saturate(2) contrast(1.2)', preview: 'linear-gradient(45deg, #7e22ce, #2563eb)', icon: 'cyclone' },
                { name: 'matrix', label: 'The Matrix', filter: 'sepia(0.5) hue-rotate(80deg) saturate(2) brightness(0.8) contrast(1.2)', preview: 'linear-gradient(45deg, #052e16, #166534)', icon: 'terminal' },
                { name: 'teal', label: 'Teal/Orange', filter: 'contrast(1.2) saturate(1.2) sepia(0.2) hue-rotate(-20deg)', preview: 'linear-gradient(45deg, #134e4a, #9a3412)', icon: 'palette' },
                { name: 'noir', label: 'Noir High', filter: 'grayscale(1) contrast(2) brightness(0.8)', preview: 'linear-gradient(45deg, #000, #444)', icon: 'camera_roll' },
                { name: 'vintage70', label: '1970s', filter: 'sepia(0.6) contrast(0.9) brightness(1.1) saturate(0.8)', preview: 'linear-gradient(45deg, #78350f, #451a03)', icon: 'history' },
                { name: 'night', label: 'Night Vision', filter: 'grayscale(1) brightness(0.5) contrast(1.5) sepia(1) hue-rotate(60deg) saturate(10)', preview: 'linear-gradient(45deg, #064e3b, #065f46)', icon: 'visibility' },
                { name: 'infra', label: 'Infrared', filter: 'invert(1) hue-rotate(180deg) saturate(3)', preview: 'linear-gradient(45deg, #7f1d1d, #991b1b)', icon: 'sensors' },
                { name: 'solar', label: 'Solarize', filter: 'invert(0.5) contrast(2)', preview: 'linear-gradient(45deg, #334155, #1e293b)', icon: 'wb_sunny' },
                { name: 'negative', label: 'Negative', filter: 'invert(1)', preview: 'linear-gradient(45deg, #fff, #000)', icon: 'difference' },
                { name: 'gold', label: 'Golden Hour', filter: 'sepia(0.3) saturate(1.5) brightness(1.1) contrast(1.1)', preview: 'linear-gradient(45deg, #f59e0b, #d97706)', icon: 'brightness_high' },
                { name: 'ocean', label: 'Ocean Deep', filter: 'hue-rotate(180deg) saturate(1.5) brightness(0.8)', preview: 'linear-gradient(45deg, #1e3a8a, #1e40af)', icon: 'waves' },
                { name: 'forest', label: 'Forest', filter: 'hue-rotate(60deg) saturate(0.8) contrast(1.1)', preview: 'linear-gradient(45deg, #064e3b, #14532d)', icon: 'forest' },
                { name: 'vapor', label: 'Vaporwave', filter: 'hue-rotate(150deg) saturate(2) brightness(1.2)', preview: 'linear-gradient(45deg, #f472b6, #38bdf8)', icon: 'auto_awesome' },
                { name: 'acid', label: 'Acid Trip', filter: 'hue-rotate(90deg) saturate(5) contrast(1.5)', preview: 'linear-gradient(45deg, #bef264, #fb7185)', icon: 'psychology' },
                { name: 'holo', label: 'Hologram', filter: 'hue-rotate(200deg) saturate(1.5) opacity(0.8)', preview: 'linear-gradient(45deg, #67e8f9, #a5f3fc)', icon: 'blur_on' },
                { name: 'pixel', label: 'Pixelate', filter: 'url(#pixel-filter)', preview: 'linear-gradient(45deg, #1e293b, #0f172a)', icon: 'grid_view' },
                { name: 'wave', label: 'Wave Distort', filter: 'url(#wave-filter)', preview: 'linear-gradient(45deg, #1e40af, #1d4ed8)', icon: 'water' },
                { name: 'chroma', label: 'Aberration', filter: 'url(#chromatic-filter)', preview: 'linear-gradient(45deg, #f43f5e, #3b82f6)', icon: 'filter_center_focus' },
                { name: 'news', label: 'Newspaper', filter: 'grayscale(1) sepia(0.5) contrast(1.2)', preview: 'linear-gradient(45deg, #d1d5db, #9ca3af)', icon: 'newspaper' },
                { name: 'glow', label: 'Soft Glow', filter: 'blur(2px) brightness(1.2)', preview: 'linear-gradient(45deg, #fffbeb, #fef3c7)', icon: 'wb_iridescent' },
                { name: 'highsat', label: 'High Sat', filter: 'saturate(3)', preview: 'linear-gradient(45deg, #facc15, #fb923c)', icon: 'shutter_speed' },
                { name: 'muted', label: 'Muted', filter: 'saturate(0.4) contrast(0.9)', preview: 'linear-gradient(45deg, #64748b, #475569)', icon: 'volume_mute' },
                { name: 'berry', label: 'Blueberry', filter: 'hue-rotate(220deg) saturate(1.5)', preview: 'linear-gradient(45deg, #3b82f6, #2563eb)', icon: 'water_drop' },
                { name: 'crimson', label: 'Crimson', filter: 'hue-rotate(-40deg) saturate(2)', preview: 'linear-gradient(45deg, #e11d48, #be123c)', icon: 'favorite' },
                { name: 'emerald', label: 'Emerald', filter: 'hue-rotate(100deg) saturate(1.5)', preview: 'linear-gradient(45deg, #10b981, #059669)', icon: 'diamond' },
                { name: 'lemon', label: 'Lemonade', filter: 'hue-rotate(40deg) saturate(1.5) brightness(1.1)', preview: 'linear-gradient(45deg, #fde047, #facc15)', icon: 'liquor' },
                { name: 'cctv', label: 'CCTV Cam', filter: 'grayscale(1) brightness(1.2) contrast(1.5) opacity(0.9)', preview: 'linear-gradient(45deg, #334155, #0f172a)', icon: 'videocam_off' },
                { name: 'poster', label: 'Posterize', filter: 'contrast(2) saturate(0.5)', preview: 'linear-gradient(45deg, #475569, #1e293b)', icon: 'collections' },
                { name: 'cool', label: 'Cool Blue', filter: 'hue-rotate(190deg) brightness(0.9)', preview: 'linear-gradient(45deg, #bfdbfe, #60a5fa)', icon: 'ac_unit' },
                { name: 'autumn', label: 'Autumn', filter: 'sepia(0.4) hue-rotate(-10deg) saturate(1.5)', preview: 'linear-gradient(45deg, #b45309, #78350f)', icon: 'eco' },
                { name: 'midnight', label: 'Midnight', filter: 'brightness(0.4) contrast(1.5) hue-rotate(240deg)', preview: 'linear-gradient(45deg, #1e1b4b, #020617)', icon: 'bedtime' },
                { name: 'dreamy', label: 'Dreamy', filter: 'blur(4px) saturate(1.2) brightness(1.1) contrast(0.9)', preview: 'linear-gradient(45deg, #fae8ff, #f5d0fe)', icon: 'cloud' },
                { name: 'sharp', label: 'Sharp', filter: 'contrast(1.5) brightness(1.1)', preview: 'linear-gradient(45deg, #cbd5e1, #94a3b8)', icon: 'filter_center_focus' },
                { name: 'thermal', label: 'Thermal', filter: 'url(#thermal-filter)', preview: 'linear-gradient(45deg, #f00, #00f)', icon: 'thermostat' },
                { name: 'halftone', label: 'Halftone', filter: 'url(#halftone-filter)', preview: 'linear-gradient(45deg, #fff, #999)', icon: 'texture' },
                { name: 'ghost', label: 'Ghostly', filter: 'opacity(0.6) blur(2px) grayscale(0.5)', preview: 'linear-gradient(45deg, #f1f5f9, #cbd5e1)', icon: 'person_outline' },
                { name: 'final', label: 'Final Cut', filter: 'contrast(1.1) saturate(1.1) brightness(1.05)', preview: 'linear-gradient(45deg, #111, #444)', icon: 'movie' },
                { name: 'sepia', label: 'Sepia Retro', filter: 'sepia(1) contrast(0.8)', preview: 'linear-gradient(45deg, #d97706, #78350f)', icon: 'history_edu' },
                { name: 'vibrant', label: 'Vibrant', filter: 'saturate(2) contrast(1.1)', preview: 'linear-gradient(45deg, #f43f5e, #fbbf24)', icon: 'bolt' },
                { name: 'pastel', label: 'Pastel', filter: 'saturate(0.6) brightness(1.2)', preview: 'linear-gradient(45deg, #fdf2f8, #f0f9ff)', icon: 'brush' },
                { name: 'lofi', label: 'Lo-Fi', filter: 'contrast(0.8) saturate(0.8) sepia(0.1)', preview: 'linear-gradient(45deg, #57534e, #292524)', icon: 'headset' },
                { name: 'infrared', label: 'Infra High', filter: 'invert(1) hue-rotate(180deg) saturate(5)', preview: 'linear-gradient(45deg, #dc2626, #7f1d1d)', icon: 'sensors' },
                { name: 'bloom', label: 'Bloom', filter: 'brightness(1.5) blur(1px)', preview: 'linear-gradient(45deg, #fff, #fef9c3)', icon: 'wb_sunny' },
                { name: 'sketch', label: 'Sketch', filter: 'grayscale(1) invert(0.1) contrast(1.5)', preview: 'linear-gradient(45deg, #e5e7eb, #9ca3af)', icon: 'edit' },
                { name: 'edge', label: 'Edge Detect', filter: 'grayscale(1) invert(1) contrast(5)', preview: 'linear-gradient(45deg, #000, #fff)', icon: 'architecture' },
                { name: 'sunset', label: 'Sunset', filter: 'sepia(0.4) saturate(1.8) hue-rotate(-30deg)', preview: 'linear-gradient(45deg, #ea580c, #9a3412)', icon: 'wb_twilight' },
                { name: 'snow', label: 'Snowfall', filter: 'none', overlay: 'effect-snow', preview: 'linear-gradient(45deg, #e0f2fe, #bae6fd)', icon: 'ac_unit' },
                { name: 'fire', label: 'Hellfire', filter: 'contrast(1.2) saturate(1.5)', overlay: 'effect-fire', preview: 'linear-gradient(45deg, #ea580c, #9a3412)', icon: 'local_fire_department' },
                { name: 'rain', label: 'Heavy Rain', filter: 'brightness(0.8) contrast(1.1)', overlay: 'effect-rain', preview: 'linear-gradient(45deg, #1e293b, #0f172a)', icon: 'water_drop' },
                { name: 'hearts', label: 'Love Float', filter: 'saturate(1.2)', overlay: 'effect-hearts', preview: 'linear-gradient(45deg, #fecdd3, #fda4af)', icon: 'favorite' },
                { name: 'stars', label: 'Starlight', filter: 'contrast(1.1)', overlay: 'effect-stars', preview: 'linear-gradient(45deg, #fef08a, #facc15)', icon: 'star' },
            ],
            showEffects: false,
            showStudioSettings: false,
            isMirrored: true,
            showGrid: false,
            activeStickers: [],
            stickerOptions: ['🔥', '✨', '🎥', '💯', '❤️', '😂', '🚀', '⭐', '👑', '😎', '🎵', '💥'],
            giphyResults: [],
            giphySearchQuery: '',
            isSearchingGiphy: false,
            giphyError: false,
            giphyOffset: 0,
            giphyCategories: ['Trending', 'Reaction', 'Love', 'Happy', 'Sad', 'Excited', 'Music', 'Nature', 'Dance', 'Funny', 'Cyberpunk', 'Glow', 'Text', 'Frames', 'Hearts', 'Sparkles', 'Fire', 'Chill', 'Food', 'Gaming', 'Workout', 'Travel', 'Aesthetic', 'Vintage', 'Anime', 'Meme', 'Animals', 'Cute', 'Cool', 'Sports', 'Art', 'Tech', 'Fashion', 'Party', 'Holiday', 'Birthday', 'Success', 'Magic', 'Sky', 'Space', 'Retro', 'Neon', 'Abstract', 'Bling', 'Cartoon', 'Comics', 'Vaporwave', 'Lo-fi', 'Glitch', 'Distortion', 'VHS', 'Pixels', 'Kawaii', 'Pastel', 'Dark', 'Mood', 'Vibe', 'Energy', 'Power', 'Money', 'Gold', 'Diamond', 'Luxury', 'Minimalist', 'Boho', 'Summer', 'Winter', 'Spring', 'Autumn', 'Coffee', 'Night', 'Sun', 'Moon'],
            activeCategory: 'Trending',
            showStickers: false,
            thumbnailFile: null,
            audioContext: null,
            mixedDest: null,
            audioPlayerSource: null,
            musicGain: null,
            micGain: null,
            micSource: null,
            recordInterval: null,
            mediaRecorder: null,
            chunks: [],
            stream: null,
            musicSearchQuery: '',
            musicSearchResults: [],
            searchingMusic: false,
            previewingId: null,
            globalMusic: null,
            showMusicModal: false,
            audioPlayer: null,
            originalAudioUrl: null,
            originalAudioTitle: null,

            toggleGreenScreen() {
                this.isGreenScreenActive = !this.isGreenScreenActive;
                if (this.isGreenScreenActive) {
                    notify('info', 'Green screen active. Stand in front of a plain background.');
                }
            },

            getInitials(name) {
                if (!name) return '??';
                const cleanName = name.trim();
                const words = cleanName.split(/\s+/);
                if (words.length >= 2) {
                    return (words[0].charAt(0) + words[words.length - 1].charAt(0)).toUpperCase();
                }
                if (cleanName.length >= 2) {
                    return (cleanName.charAt(0) + cleanName.charAt(cleanName.length - 1)).toUpperCase();
                }
                return cleanName.toUpperCase();
            },
            
            musicLibrary: {!! json_encode($musicTracks->map(function($m) {
                $file = $m->file_path ?? $m->audio_path;
                $reel = \App\Models\Reel::where('video_path', $file)
                    ->orWhere('compressed_video_path', $file)
                    ->first();
                if ($reel) {
                    $url = $reel->getVideoUrl();
                    if ($reel->isBunnyReel()) {
                        $url = str_replace('play_1080p.mp4', 'play_360p.mp4', $url);
                    }
                    $thumbnail = $reel->user->image 
                        ? getImage(getFilePath('userProfile') . '/' . $reel->user->image) 
                        : null;
                } else {
                    if (str_starts_with($file, 'http')) {
                        $url = str_contains($file, 'play_1080p.mp4') ? str_replace('play_1080p.mp4', 'play_360p.mp4', $file) : $file;
                    } else {
                        $filePath = getFilePath('reelMusic') . '/' . $file;
                        if (!file_exists(public_path($filePath))) {
                            $fallbackPath = getFilePath('reel') . '/' . $file;
                            if (file_exists(public_path($fallbackPath))) {
                                $filePath = $fallbackPath;
                            }
                        }
                        $url = asset($filePath);
                    }
                    $thumbnail = $m->cover_image ? asset(getFilePath('reelMusic') . '/' . $m->cover_image) : null;
                }
                return [
                    'id' => $m->id,
                    'title' => $m->title,
                    'artist' => $m->artist ?? 'Unknown',
                    'thumbnail' => $thumbnail,
                    'url' => $url
                ];
            })) !!},

            uploadedAudioName: '',
            uploadedAudioUrl: null,
            audioPreviewPlaying: false,

            handleAudioUpload(event) {
                const file = event.target.files[0];
                if (file) {
                    this.uploadedMusicFile = file;
                    this.uploadedAudioName = file.name;
                    if (this.uploadedAudioUrl) {
                        URL.revokeObjectURL(this.uploadedAudioUrl);
                    }
                    this.uploadedAudioUrl = URL.createObjectURL(file);
                    
                    const nameInput = document.querySelector('input[name="audio_name"]');
                    if (nameInput && !nameInput.value) {
                        nameInput.value = file.name.replace(/\.[^/.]+$/, "");
                    }
                    this.audioPreviewPlaying = false;
                }
            },

            toggleAudioPreview() {
                const audio = this.$refs.audioPreviewElement;
                if (!audio) return;
                
                if (this.audioPreviewPlaying) {
                    audio.pause();
                    this.audioPreviewPlaying = false;
                } else {
                    audio.play();
                    this.audioPreviewPlaying = true;
                }
            },

            async init() {
                // Fetch default iTunes tracks
                this.searchMusic('trending');
                
                this.$watch('showMusicModal', (value) => {
                    if (!value) {
                        if (this.audioPlayer) this.audioPlayer.pause();
                        this.previewingId = null;
                    }
                });
                this.$watch('musicId', (val) => {
                    if (val) {
                        if (String(val).startsWith('itunes_')) return;
                        
                        const track = this.musicLibrary.find(m => m.id == val);
                        if (track) {
                            this.globalMusic = track;
                        } else {
                            this.globalMusic = null;
                        }
                    } else {
                        this.globalMusic = null;
                    }
                });

                const params = new URLSearchParams(window.location.search);
                const mid = params.get('music_id');
                const pid = params.get('parent_id');
                const orid = params.get('original_reel_id');
                const did = params.get('duet_id');

                if (mid) {
                    this.musicId = mid;
                    this.musicSource = 'library';
                    const track = this.musicLibrary.find(m => m.id == mid);
                    if (track) {
                        this.globalMusic = track;
                        this.musicSource = 'global';
                    }
                }
                if (pid) {
                    this.parentId = pid;
                }
                if (did) {
                    this.parentId = did;
                    this.mode = 'record';
                    this.startCamera();
                }
                if (orid) {
                    this.musicSource = 'original';
                    try {
                        const res = await fetch(`/reels/${orid}/info`);
                        const d = await res.json();
                        if (d.success) {
                            this.originalAudioUrl = d.audio_url;
                            this.originalAudioTitle = d.title;
                            this.originalReelId = orid;
                            this.mode = 'record';
                            this.startCamera();
                        }
                    } catch (e) {
                        console.error("Failed to fetch original audio:", e);
                    }
                }
                this.$watch('micVolume', (val) => {
                    if (this.micGain) this.micGain.gain.value = val;
                });
                this.$watch('musicVolume', (val) => {
                    if (this.musicGain) this.musicGain.gain.value = val;
                });
                
                this.$watch('showStickers', (val) => {
                    if (val && !this.giphySearchQuery) {
                        this.loadTrendingStickers();
                    }
                });
                
                // Pre-warm AudioContext on first interaction
                const warmAudio = () => {
                    if (!this.audioContext) {
                        this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                        this.mixedDest = this.audioContext.createMediaStreamDestination();
                    }
                    if (this.audioContext.state === 'suspended') {
                        this.audioContext.resume();
                    }
                    document.removeEventListener('touchstart', warmAudio);
                    document.removeEventListener('mousedown', warmAudio);
                };
                document.addEventListener('touchstart', warmAudio);
                document.addEventListener('mousedown', warmAudio);
            },

            async searchMusic(defaultQuery = null) {
                let query = defaultQuery || this.musicSearchQuery;
                
                if (!query || query.length < 2) {
                    if (this.musicSearchQuery === '') {
                        query = 'trending';
                    } else {
                        return;
                    }
                }
                
                this.searchingMusic = true;
                try {
                    let itunesTracks = [];
                    
                    if (query === 'trending') {
                        // Fetch actual Top 100 iTunes songs for India (Hindi, Telugu, Tamil, etc)
                        const rssRes = await fetch('https://itunes.apple.com/in/rss/topsongs/limit=100/json');
                        const rssData = await rssRes.json();
                        if (rssData && rssData.feed && rssData.feed.entry) {
                            itunesTracks = rssData.feed.entry.map(item => {
                                const linkPreview = Array.isArray(item.link) ? item.link.find(l => l.attributes && l.attributes.rel === 'enclosure') : null;
                                return {
                                    id: 'itunes_' + item.id.attributes['im:id'],
                                    title: item['im:name'].label,
                                    artist: item['im:artist'].label,
                                    thumbnail: item['im:image'] && item['im:image'].length > 0 ? item['im:image'][item['im:image'].length - 1].label : null,
                                    url: linkPreview ? linkPreview.attributes.href : null
                                };
                            }).filter(t => t.url);
                        }
                    } else {
                        // Standard search
                        const itunesRes = await fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(query)}&entity=song&limit=30&country=in`);
                        const itunesData = await itunesRes.json();
                        itunesTracks = (itunesData.results || []).map(item => ({
                            id: 'itunes_' + item.trackId,
                            title: item.trackName,
                            artist: item.artistName,
                            thumbnail: item.artworkUrl100,
                            url: item.previewUrl
                        })).filter(t => t.url);
                    }

                    // Secondary: local library (admin-uploaded tracks)
                    let localTracks = [];
                    if (query !== 'trending') {
                        try {
                            const localRes = await fetch(`/reels/music/search?q=${encodeURIComponent(query)}`);
                            if (localRes.ok) {
                                const localData = await localRes.json();
                                localTracks = (localData.tracks || []).map(t => ({ ...t, id: 'local_' + t.id }));
                            }
                        } catch (_) {}
                    }

                    this.musicSearchResults = [...localTracks, ...itunesTracks];
                } catch (err) {
                    console.error("Music search failed:", err);
                } finally {
                    this.searchingMusic = false;
                }
            },

            toggleMusicPreview(song) {
                if (this.previewingId == song.id) {
                    this.audioPlayer.pause();
                    this.previewingId = null;
                } else {
                    if (this.audioPlayer) this.audioPlayer.pause();
                    this.audioPlayer = new Audio(song.url);
                    this.audioPlayer.play();
                    this.previewingId = song.id;
                    this.audioPlayer.onended = () => this.previewingId = null;
                }
            },

            selectGlobalMusic(song) {
                this.musicId = song.id;
                this.globalMusic = song;
                this.musicSource = 'global';
                if (this.audioPlayer) this.audioPlayer.pause();
                this.previewingId = null;
                this.showMusicModal = false;
            },

            async searchGiphy(append = false) {
                if (!this.giphySearchQuery) {
                    this.giphyResults = [];
                    this.giphyOffset = 0;
                    return;
                }
                if (!append) {
                    this.giphyResults = [];
                    this.giphyOffset = 0;
                }
                this.isSearchingGiphy = true;
                try {
                    const apiKey = '{{ gs('giphy_api_key') }}' || 'dc6zaTOxFJmzC'; 
                    const response = await fetch(`https://api.giphy.com/v1/stickers/search?api_key=${apiKey}&q=${encodeURIComponent(this.giphySearchQuery)}&limit=100&offset=${this.giphyOffset}&rating=g`);
                    
                    if (response.status === 403) {
                        this.giphyError = true;
                        notify('error', 'Giphy API access forbidden. Please verify your API key in Admin Settings.');
                        return;
                    }
                    this.giphyError = false;

                    const data = await response.json();
                    if (data.data) {
                        const newResults = data.data.map(img => ({
                            url: img.images.fixed_height_small.url,
                            fullUrl: img.images.fixed_height.url
                        }));
                        if (append) this.giphyResults = [...this.giphyResults, ...newResults];
                        else this.giphyResults = newResults;
                        this.giphyOffset += 100;
                    }
                } catch (err) {
                    console.error('Giphy search error:', err);
                } finally {
                    this.isSearchingGiphy = false;
                }
            },

            async loadTrendingStickers(append = false) {
                if (!append && this.giphyResults.length > 0) return;
                this.isSearchingGiphy = true;
                try {
                    const apiKey = '{{ gs('giphy_api_key') }}' || 'dc6zaTOxFJmzC'; 
                    const response = await fetch(`https://api.giphy.com/v1/stickers/trending?api_key=${apiKey}&limit=100&offset=${this.giphyOffset}&rating=g`);
                    
                    if (response.status === 403) {
                        this.giphyError = true;
                        console.error('Giphy API Key Forbidden (403)');
                        return;
                    }
                    this.giphyError = false;

                    const data = await response.json();
                    if (data.data) {
                        const newResults = data.data.map(img => ({
                            url: img.images.fixed_height_small.url,
                            fullUrl: img.images.fixed_height.url
                        }));
                        if (append) this.giphyResults = [...this.giphyResults, ...newResults];
                        else this.giphyResults = newResults;
                        this.giphyOffset += 100;
                    }
                } catch (err) {
                    console.error('Giphy trending error:', err);
                } finally {
                    this.isSearchingGiphy = false;
                }
            },

            addSticker(url, isEmoji = false) {
                this.activeStickers.push({
                    id: Date.now(),
                    url: url,
                    isEmoji: isEmoji,
                    x: 50,
                    y: 50,
                    isDragging: false
                });
                this.showStickers = false;
            },

            startStickerDrag(id, e) {
                const sticker = this.activeStickers.find(s => s.id === id);
                if (!sticker) return;

                const startX = e.type === 'touchstart' ? e.touches[0].clientX : e.clientX;
                const startY = e.type === 'touchstart' ? e.touches[0].clientY : e.clientY;
                const initialX = sticker.x;
                const initialY = sticker.y;

                const move = (moveEvent) => {
                    const currentX = moveEvent.type === 'touchmove' ? moveEvent.touches[0].clientX : moveEvent.clientX;
                    const currentY = moveEvent.type === 'touchmove' ? moveEvent.touches[0].clientY : moveEvent.clientY;
                    
                    const dx = ((currentX - startX) / window.innerWidth) * 100;
                    const dy = ((currentY - startY) / window.innerHeight) * 100;
                    
                    sticker.x = Math.max(0, Math.min(100, initialX + dx));
                    sticker.y = Math.max(0, Math.min(100, initialY + dy));
                };

                const up = () => {
                    document.removeEventListener('mousemove', move);
                    document.removeEventListener('mouseup', up);
                    document.removeEventListener('touchmove', move);
                    document.removeEventListener('touchend', up);
                };

                document.addEventListener('mousemove', move);
                document.addEventListener('mouseup', up);
                document.addEventListener('touchmove', move);
                document.addEventListener('touchend', up);
            },

            async startCamera() {
                this.mode = 'record';
                try {
                    if (this.stream) {
                        this.stream.getTracks().forEach(track => track.stop());
                    }
                    const videoConstraints = {
                        width: { ideal: 1920, min: 1280 },
                        height: { ideal: 1080, min: 720 },
                        aspectRatio: { ideal: 9/16 }
                    };
                    
                    if (this.facingMode === 'environment') {
                        videoConstraints.facingMode = { exact: 'environment' };
                    } else {
                        videoConstraints.facingMode = { ideal: 'user' };
                    }

                    this.stream = await navigator.mediaDevices.getUserMedia({ 
                        video: videoConstraints, 
                        audio: {
                            echoCancellation: true,
                            noiseSuppression: true
                        }
                    });
                    
                    if (this.stream) {
                        const track = this.stream.getVideoTracks()[0];
                        if (this.$refs.cameraPreview) {
                            this.$refs.cameraPreview.srcObject = this.stream;
                            this.$refs.cameraPreview.play();
                        }
                        
                        const capabilities = track.getCapabilities ? track.getCapabilities() : {};
                        if ('zoom' in capabilities) {
                            this.zoomSupported = true;
                            this.zoomMin = capabilities.zoom.min || 1;
                            this.zoomMax = capabilities.zoom.max || 3;
                            this.zoomStep = capabilities.zoom.step || 0.1;
                            this.zoomLevel = 1; // Default
                        } else {
                            this.zoomSupported = false;
                            this.zoomLevel = 1;
                        }
                    }
                } catch (err) {
                    notify('error', 'Could not access camera: ' + err.message);
                    this.mode = 'upload';
                }
            },

            async toggleFlash() {
                if (!this.stream) return;
                const track = this.stream.getVideoTracks()[0];
                
                try {
                    this.isFlashOn = !this.isFlashOn;
                    
                    // Android Hack: Some Samsung/Android devices require ImageCapture to be initialized 
                    // before they will "wake up" and accept the torch constraint.
                    if (window.ImageCapture) {
                        try { new ImageCapture(track); } catch(e) {}
                    }
                    
                    const constraints = track.getConstraints() || {};
                    constraints.advanced = constraints.advanced || [];
                    constraints.advanced = constraints.advanced.filter(c => c.torch === undefined);
                    constraints.advanced.push({ torch: this.isFlashOn });
                    
                    try {
                        await track.applyConstraints(constraints);
                    } catch (e) {
                        await track.applyConstraints({ advanced: [{ torch: this.isFlashOn }] });
                    }
                } catch (err) {
                    console.error('Flash control error:', err);
                    notify('error', 'Your device hardware rejected the flash command.');
                    this.isFlashOn = false;
                }
            },

            async flipCamera() {
                this.facingMode = this.facingMode === 'user' ? 'environment' : 'user';
                this.isMirrored = this.facingMode === 'user';
                await this.startCamera();
            },

            async searchGiphy() {
                if (!this.giphySearchQuery) {
                    this.giphyResults = [];
                    return;
                }
                this.isSearchingGiphy = true;
                try {
                    const apiKey = '{{ gs('giphy_api_key') }}' || 'dc6zaTOxFJmzC'; 
                    console.log('Searching Giphy with key:', apiKey, 'Query:', this.giphySearchQuery);
                    const response = await fetch(`https://api.giphy.com/v1/stickers/search?api_key=${apiKey}&q=${encodeURIComponent(this.giphySearchQuery)}&limit=24&rating=g`);
                    const data = await response.json();
                    if (data.data) {
                        this.giphyResults = data.data.map(img => ({
                            url: img.images.fixed_height_small.url,
                            fullUrl: img.images.fixed_height.url
                        }));
                    } else {
                        console.warn('Giphy returned no data:', data);
                    }
                } catch (err) {
                    console.error('Giphy search error:', err);
                } finally {
                    this.isSearchingGiphy = false;
                }
            },

            async loadTrendingStickers() {
                if (this.giphyResults.length > 0) return; // already loaded or searched
                this.isSearchingGiphy = true;
                try {
                    const apiKey = '{{ gs('giphy_api_key') }}' || 'dc6zaTOxFJmzC'; 
                    console.log('Loading Trending Giphy Stickers...');
                    const response = await fetch(`https://api.giphy.com/v1/stickers/trending?api_key=${apiKey}&limit=24&rating=g`);
                    const data = await response.json();
                    if (data.data) {
                        this.giphyResults = data.data.map(img => ({
                            url: img.images.fixed_height_small.url,
                            fullUrl: img.images.fixed_height.url
                        }));
                    }
                } catch (err) {
                    console.error('Giphy trending error:', err);
                } finally {
                    this.isSearchingGiphy = false;
                }
            },

            addSticker(url, isEmoji = false) {
                this.activeStickers.push({
                    id: Date.now(),
                    url: url,
                    isEmoji: isEmoji,
                    x: 50, // center x percentage
                    y: 50, // center y percentage
                    isDragging: false
                });
                this.showStickers = false;
            },

            startStickerDrag(id, e) {
                const sticker = this.activeStickers.find(s => s.id === id);
                if (!sticker) return;
                sticker.isDragging = true;
                
                const moveHandler = (moveEvent) => {
                    if (!sticker.isDragging) return;
                    const touch = moveEvent.touches ? moveEvent.touches[0] : moveEvent;
                    const rect = this.$refs.cameraPreview.parentElement.getBoundingClientRect();
                    
                    sticker.x = ((touch.clientX - rect.left) / rect.width) * 100;
                    sticker.y = ((touch.clientY - rect.top) / rect.height) * 100;
                };

                const stopHandler = () => {
                    sticker.isDragging = false;
                    window.removeEventListener('mousemove', moveHandler);
                    window.removeEventListener('touchmove', moveHandler);
                    window.removeEventListener('mouseup', stopHandler);
                    window.removeEventListener('touchend', stopHandler);
                };

                window.addEventListener('mousemove', moveHandler);
                window.addEventListener('touchmove', moveHandler);
                window.addEventListener('mouseup', stopHandler);
                window.addEventListener('touchend', stopHandler);
            },

            updateZoom() {
                if (!this.stream) return;
                const track = this.stream.getVideoTracks()[0];
                if (track && this.zoomSupported) {
                    track.applyConstraints({ advanced: [{ zoom: parseFloat(this.zoomLevel) }] })
                         .catch(e => console.log('Zoom error:', e));
                }
            },

            stopCamera() {
                if (this.stream) {
                    this.stream.getTracks().forEach(track => track.stop());
                }
                if (this.audioPlayer) {
                    this.audioPlayer.pause();
                    this.audioPlayer = null;
                }
                if (this.recordingAudioPlayer) {
                    this.recordingAudioPlayer.pause();
                    this.recordingAudioPlayer = null;
                }
                this.mode = 'upload';
                this.isRecording = false;
                this.isPaused = false;
                this.shouldSaveDraft = false;
                clearInterval(this.recordInterval);
            },

            async startRecording() {
                // Determine music URL synchronously first
                let musicUrl = null;
                if (this.musicSource == 'global' && this.globalMusic) {
                    musicUrl = this.globalMusic.url;
                } else if (this.originalAudioUrl) {
                    musicUrl = this.originalAudioUrl;
                } else if (this.musicId) {
                    const track = this.musicLibrary.find(m => m.id == this.musicId);
                    if (track) musicUrl = track.url;
                }
                
                if (musicUrl) {
                    const assetIndex = musicUrl.indexOf('/assets/');
                    if (assetIndex !== -1 && !musicUrl.includes('itunes.apple.com')) {
                        musicUrl = musicUrl.substring(assetIndex);
                    }
                    
                    const isExternalCORS = musicUrl.includes('itunes.apple.com');
                    
                    if (this.recordingAudioPlayer) {
                        this.recordingAudioPlayer.pause();
                        this.recordingAudioPlayer.src = '';
                    }
                    
                    this.recordingAudioPlayer = new Audio();
                    if (!isExternalCORS) {
                        this.recordingAudioPlayer.crossOrigin = "anonymous";
                    } else {
                        this.recordingAudioPlayer.volume = parseFloat(this.musicVolume);
                    }
                    
                    this.recordingAudioPlayer.src = musicUrl;
                    this.recordingAudioPlayer.currentTime = this.musicStartTime;
                    
                    // PLAY SYNCHRONOUSLY BEFORE ANY AWAIT (Solves Safari/Mobile Autoplay Policy)
                    const playPromise = this.recordingAudioPlayer.play();
                    if (playPromise !== undefined) {
                        playPromise.catch(err => console.log("Play error (expected on some devices):", err));
                    }
                }

                this.chunks = [];
                this.recordTime = 0;
                
                const duetVideo = document.getElementById('duetVideo');
                if (duetVideo) {
                    duetVideo.muted = false;
                    duetVideo.volume = 1.0;
                    duetVideo.currentTime = 0;
                    duetVideo.play().catch(e => console.log('Duet video play error:', e));
                }
                
                const canvas = document.createElement('canvas');
                const video = this.$refs.cameraPreview;
                
                // Set canvas size to match video aspect ratio
                canvas.width = 720;
                canvas.height = 1280;
                const ctx = canvas.getContext('2d');

                this.isRecording = true;
                this.isPaused = false;
                this.shouldSaveDraft = false;
                
                const drawFrame = () => {
                    if (!this.isRecording) return;
                    
                    ctx.save();
                    
                    // 1. Apply Filter
                    ctx.filter = this.activeFilter.filter;
                    
                    // 2. Calculate crop for object-fit: cover
                    const videoRatio = video.videoWidth / video.videoHeight;
                    const canvasRatio = canvas.width / canvas.height;
                    let drawWidth = video.videoWidth;
                    let drawHeight = video.videoHeight;
                    let offsetX = 0;
                    let offsetY = 0;

                    if (videoRatio > canvasRatio) {
                        drawWidth = video.videoHeight * canvasRatio;
                        offsetX = (video.videoWidth - drawWidth) / 2;
                    } else {
                        drawHeight = video.videoWidth / canvasRatio;
                        offsetY = (video.videoHeight - drawHeight) / 2;
                    }

                    // 3. Mirror if user-facing
                    if (this.facingMode === 'user') {
                        ctx.translate(canvas.width, 0);
                        ctx.scale(-1, 1);
                    }
                    
                    // 4. Draw Video
                    ctx.drawImage(video, offsetX, offsetY, drawWidth, drawHeight, 0, 0, canvas.width, canvas.height);
                    
                    ctx.restore();
                    
                    // 5. Draw Stickers (unmirrored)
                    this.activeStickers.forEach(s => {
                        const sx = (s.x / 100) * canvas.width;
                        const sy = (s.y / 100) * canvas.height;
                        
                        if (s.isEmoji) {
                            ctx.font = '120px serif';
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'middle';
                            ctx.fillText(s.url, sx, sy);
                        } else {
                            // Using a cached image or creating one
                            const img = new Image();
                            img.src = s.url;
                            img.crossOrigin = "anonymous";
                            // Stickers are roughly 200px on 720p canvas
                            ctx.drawImage(img, sx - 100, sy - 100, 200, 200);
                        }
                    });

                    requestAnimationFrame(drawFrame);
                };
                drawFrame();

                const canvasStream = canvas.captureStream(30);
                
                if (!this.audioContext) {
                    this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                    this.mixedDest = this.audioContext.createMediaStreamDestination();
                }
                
                const audioContext = this.audioContext;
                const mixedDest = this.mixedDest;
                
                if (audioContext.state === 'suspended') {
                    await audioContext.resume();
                }

                // 1. Mic Audio - Always recreate source to ensure it matches current camera stream
                if (this.micSource) {
                    this.micSource.disconnect();
                }
                this.micSource = audioContext.createMediaStreamSource(this.stream);
                if (!this.micGain) {
                    this.micGain = audioContext.createGain();
                }
                this.micSource.connect(this.micGain);
                this.micGain.connect(mixedDest);
                this.micGain.gain.value = parseFloat(this.micVolume);

                // 2. Music Audio Graph Connection
                if (musicUrl && this.recordingAudioPlayer) {
                    const isExternalCORS = musicUrl.includes('itunes.apple.com');
                    if (!isExternalCORS) {
                        const newSource = audioContext.createMediaElementSource(this.recordingAudioPlayer);
                        if (!this.musicGain) {
                            this.musicGain = audioContext.createGain();
                            this.musicGain.connect(mixedDest);
                            this.musicGain.connect(audioContext.destination);
                        }
                        newSource.connect(this.musicGain);
                        this.musicGain.gain.value = parseFloat(this.musicVolume);
                    }
                }

                // Add mixed audio to canvas stream
                const finalStream = new MediaStream([
                    ...canvasStream.getVideoTracks(),
                    ...mixedDest.stream.getAudioTracks()
                ]);

                // Determine best supported mimeType
                let types = ['video/webm;codecs=vp9,opus', 'video/webm;codecs=vp8,opus', 'video/webm', 'video/mp4'];
                let selectedType = types.find(t => MediaRecorder.isTypeSupported(t)) || '';

                this.mediaRecorder = new MediaRecorder(finalStream, selectedType ? { mimeType: selectedType } : {});
                this.mediaRecorder.ondataavailable = (e) => this.chunks.push(e.data);
                this.mediaRecorder.onstop = async () => {
                    if (this.audioPlayer) this.audioPlayer.pause();
                    if (this.recordingAudioPlayer) {
                        this.recordingAudioPlayer.pause();
                        this.recordingAudioPlayer.src = '';
                    }
                    const blob = new Blob(this.chunks, { type: 'video/webm' });
                    this.videoFile = new File([blob], `recorded_reel_${Date.now()}.webm`, { type: 'video/webm' });
                    this.videoPreview = URL.createObjectURL(blob);
                    
                    // Capture thumbnail
                    try {
                        const canvas = document.createElement('canvas');
                        canvas.width = 720;
                        canvas.height = 1280;
                        const ctx = canvas.getContext('2d');
                        
                        const duetVideo = document.getElementById('duetVideo');
                        if (duetVideo) {
                            // Left side - Duet Parent
                            ctx.save();
                            ctx.rect(0, 0, 360, 1280);
                            ctx.clip();
                            ctx.drawImage(duetVideo, -180, 0, 720, 1280);
                            ctx.restore();

                            // Right side - Camera
                            ctx.save();
                            ctx.rect(360, 0, 360, 1280);
                            ctx.clip();
                            ctx.drawImage(this.$refs.cameraPreview, 180, 0, 720, 1280);
                            ctx.restore();
                        } else {
                            ctx.drawImage(this.$refs.cameraPreview, 0, 0, canvas.width, canvas.height);
                        }
                        
                        this.thumbnailPreview = canvas.toDataURL('image/jpeg', 0.8);
                        
                        // Convert to file
                        const thumbBlob = await (await fetch(this.thumbnailPreview)).blob();
                        this.thumbnailFile = new File([thumbBlob], 'thumbnail.jpg', { type: 'image/jpeg' });
                    } catch (e) {
                        console.error("Thumbnail capture failed:", e);
                    }

                    this.duration = this.recordTime;
                    this.durationDisplay = this.formatTime(this.duration);
                    this.step = 2;
                    this.stopCamera();
                    
                    if (this.shouldSaveDraft) {
                        this.shouldSaveDraft = false;
                        setTimeout(() => {
                            this.startUpload(true);
                        }, 200);
                    }
                };

                this.mediaRecorder.start();
                this.recordInterval = setInterval(() => {
                    this.recordTime++;
                    if (this.recordTime >= this.maxDuration) this.stopRecording();
                }, 1000);
            },

            stopRecording() {
                this.isRecording = false;
                this.isPaused = false;
                if (this.mediaRecorder && this.mediaRecorder.state !== 'inactive') this.mediaRecorder.stop();
                clearInterval(this.recordInterval);
                const duetVideo = document.getElementById('duetVideo');
                if (duetVideo) {
                    duetVideo.pause();
                }
            },
            
            pauseRecording() {
                if (!this.isRecording || this.isPaused) return;
                this.isPaused = true;
                if (this.mediaRecorder && this.mediaRecorder.state === 'recording') {
                    this.mediaRecorder.pause();
                }
                if (this.recordingAudioPlayer) {
                    this.recordingAudioPlayer.pause();
                }
                const duetVideo = document.getElementById('duetVideo');
                if (duetVideo) {
                    duetVideo.pause();
                }
                clearInterval(this.recordInterval);
            },
            
            resumeRecording() {
                if (!this.isRecording || !this.isPaused) return;
                this.isPaused = false;
                if (this.mediaRecorder && this.mediaRecorder.state === 'paused') {
                    this.mediaRecorder.resume();
                }
                if (this.recordingAudioPlayer) {
                    this.recordingAudioPlayer.play().catch(e => console.error(e));
                }
                const duetVideo = document.getElementById('duetVideo');
                if (duetVideo) {
                    duetVideo.play().catch(e => console.error(e));
                }
                this.recordInterval = setInterval(() => {
                    this.recordTime++;
                    if (this.recordTime >= this.maxDuration) this.stopRecording();
                }, 1000);
            },
            
            confirmCancelRecording() {
                this.pauseRecording();
                Swal.fire({
                    title: 'Save or Discard?',
                    text: 'Do you want to discard this recording or save it as a draft?',
                    icon: 'question',
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: 'Save Draft',
                    denyButtonText: 'Discard',
                    cancelButtonText: 'Resume',
                    confirmButtonColor: '#ff571a',
                    denyButtonColor: '#ef4444',
                    background: document.documentElement.classList.contains('dark') ? '#1A1A1A' : '#ffffff',
                    color: document.documentElement.classList.contains('dark') ? '#ffffff' : '#000000',
                    customClass: {
                        popup: 'rounded-[2rem]',
                        confirmButton: 'rounded-xl font-bold px-4 py-2',
                        denyButton: 'rounded-xl font-bold px-4 py-2 text-white',
                        cancelButton: 'rounded-xl font-bold px-4 py-2'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        this.shouldSaveDraft = true;
                        this.stopRecording();
                    } else if (result.isDenied) {
                        this.stopCamera();
                        this.startCamera(); // restart fresh
                    } else {
                        this.resumeRecording();
                    }
                });
            },

            formatTime(seconds) {
                const m = Math.floor(seconds / 60);
                const s = Math.floor(seconds % 60);
                return `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
            },

            async confirmBack() {
                if (this.videoFile && !this.uploading) {
                    const result = await Swal.fire({
                        title: 'Save as Draft?',
                        text: "Do you want to save this reel as a draft before going back?",
                        icon: 'question',
                        showCancelButton: true,
                        showDenyButton: true,
                        confirmButtonText: 'Save Draft',
                        denyButtonText: 'Discard',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#ff571a',
                        denyButtonColor: '#272727',
                        background: '#1A1A1A',
                        color: '#ffffff'
                    });

                    if (result.isConfirmed) {
                        this.startUpload(true); // pass true for isDraft
                    } else if (result.isDenied) {
                        this.videoFile = null;
                        this.videoPreview = null;
                        this.step = 1;
                    }
                } else {
                    this.step = 1;
                }
            },

            onVideoChange(e) {
                const file = e.target.files[0];
                if (!file) return;

                this.videoFile = file;
                if (this.videoPreview) URL.revokeObjectURL(this.videoPreview);
                const objUrl = URL.createObjectURL(file);
                this.videoPreview = objUrl;
                this.step = 2;

                this.duration = 0;
                this.durationDisplay = '00:00';

                // Mobile-first duration and preview fix
                setTimeout(() => {
                    const player = this.$refs.previewPlayer;
                    if (player) {
                        player.muted = true;
                        player.playsInline = true;
                        player.setAttribute('muted', '');
                        player.setAttribute('playsinline', '');
                        
                        // Already handled by :src binding, but manual load for mobile consistency
                        player.load();
                        
                        const playPromise = player.play();
                        if (playPromise !== undefined) {
                            playPromise.catch(err => {
                                console.log('Autoplay prevented', err);
                                // Fallback: user interaction will eventually trigger it since it's step 2
                            });
                        }

                        player.onloadedmetadata = () => {
                            const checkAndApplyDuration = (d) => {
                                if (d > 90) {
                                    if (window.Swal) {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Video Too Long',
                                            text: 'Reels must be 90 seconds or shorter.',
                                            confirmButtonColor: '#ff571a'
                                        });
                                    } else {
                                        alert('Reel must be 90 seconds or shorter!');
                                    }
                                    this.removeVideo();
                                    return;
                                }
                                this.duration = Math.round(d);
                                this.durationDisplay = this.formatTime(d);
                            };

                            let d = player.duration;
                            if (d === Infinity || isNaN(d)) {
                                player.currentTime = 1e101;
                                player.onseeked = () => {
                                    player.onseeked = null;
                                    d = player.duration;
                                    if (d && !isNaN(d) && d !== Infinity) {
                                        checkAndApplyDuration(d);
                                    }
                                    player.currentTime = 0;
                                };
                            } else if (d && !isNaN(d)) {
                                checkAndApplyDuration(d);
                            }
                        };
                    }
                }, 200);

                if (!this.title && file.name) {
                    let name = file.name.replace(/\.[^/.]+$/, '');
                    if (name.toLowerCase() === 'image' || name.toLowerCase() === 'video' || /^1000\d+$/.test(name)) {
                        name = 'Reel ' + new Date().toLocaleDateString();
                    }
                    this.title = name.replace(/[_-]/g, ' ');
                }
            },
            removeVideo() {
                if (this.videoPreview) URL.revokeObjectURL(this.videoPreview);
                this.videoFile = null;
                this.videoPreview = null;
                this.duration = 0;
                this.durationDisplay = '00:00';
                this.step = 1;
                const input = document.querySelector('input[name="video"]');
                if (input) input.value = '';
            },
            onThumbnailChange(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (ev) => this.thumbnailPreview = ev.target.result;
                    reader.readAsDataURL(file);
                    this.thumbnailFile = file;
                }
            },
            removeThumbnail() {
                this.thumbnailPreview = null;
                this.thumbnailFile = null;
                const input = document.querySelector('input[name="thumbnail"]');
                if (input) input.value = '';
            },
            confirmBack() {
                if (this.videoFile) {
                    Swal.fire({
                        title: 'Discard Reel?',
                        text: "All your progress and recorded segments will be lost.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, Discard',
                        cancelButtonText: 'Keep Editing',
                        confirmButtonColor: '#ef4444',
                        cancelButtonColor: '#64748b',
                        background: document.documentElement.classList.contains('dark') ? '#1A1A1A' : '#ffffff',
                        color: document.documentElement.classList.contains('dark') ? '#ffffff' : '#000000',
                        customClass: {
                            popup: 'rounded-[2rem]',
                            confirmButton: 'rounded-xl font-bold px-8 py-3',
                            cancelButton: 'rounded-xl font-bold px-8 py-3'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.reload();
                        }
                    });
                } else {
                    this.step = 1;
                    this.mode = 'upload';
                    this.stopCamera();
                }
            },

            resetStudio() {
                this.step = 1;
                this.videoFile = null;
                this.videoPreview = null;
                this.thumbnailPreview = null;
                this.title = '';
                this.description = '';
                this.stopCamera();
            },
            async startUpload(isDraft = false) {
                // Ensure isDraft is a boolean (prevents Event object from being treated as true)
                if (typeof isDraft !== 'boolean') isDraft = false;
                
                if (this.step < 2) return;
                
                const categoryId = document.querySelector('select[name="category_id"]').value;
                
                if (!this.title && !isDraft) {
                    Swal.fire({
                        title: 'Missing Title',
                        text: 'Give your reel a catchy title before sharing it with the world.',
                        icon: 'warning',
                        confirmButtonText: 'Got it',
                        confirmButtonColor: '#ff571a',
                        background: document.documentElement.classList.contains('dark') ? '#1A1A1A' : '#ffffff',
                        color: document.documentElement.classList.contains('dark') ? '#ffffff' : '#000000',
                        customClass: {
                            popup: 'rounded-[2rem]',
                            confirmButton: 'rounded-xl font-bold px-8 py-3'
                        }
                    });
                    return;
                }

                const catId = document.querySelector('select[name="category_id"]')?.value;
                if (!catId && !isDraft) {
                    Swal.fire({
                        title: 'Select Category',
                        text: 'Choose a category to help viewers find your reel.',
                        icon: 'warning',
                        confirmButtonText: 'Select Now',
                        confirmButtonColor: '#ff571a',
                        background: document.documentElement.classList.contains('dark') ? '#1A1A1A' : '#ffffff',
                        color: document.documentElement.classList.contains('dark') ? '#ffffff' : '#000000',
                        customClass: {
                            popup: 'rounded-[2rem]',
                            confirmButton: 'rounded-xl font-bold px-8 py-3'
                        }
                    });
                    return;
                }

                if (!this.videoFile) {
                    Swal.fire({
                        title: 'Select Video',
                        text: 'You need to record or upload a video first.',
                        icon: 'error',
                        confirmButtonText: 'Let\'s Go',
                        confirmButtonColor: '#ff571a',
                        background: '#1A1A1A',
                        color: '#ffffff',
                        customClass: {
                            popup: 'rounded-[2rem]',
                            confirmButton: 'rounded-xl font-bold px-8 py-3'
                        }
                    });
                    this.step = 1;
                    return;
                }

                if (window.showPublishingLoader) {
                    window.showPublishingLoader(isDraft ? 'draft' : 'reel');
                }

                this.uploading = true;
                this.progress = 0;

                try {
                    // 1. Prepare upload via backend
                    const formData = new FormData();
                    formData.append('title', this.title);
                    formData.append('description', this.description);
                    if(categoryId) formData.append('category_id', categoryId);
                    formData.append('visibility', this.visibility);
                    formData.append('location', this.location);
                    formData.append('duration', this.duration);
                    formData.append('hashtags', JSON.stringify(this.tags));
                    if (isDraft) formData.append('is_draft', '1');
                    
                    if (this.musicId && this.musicSource != 'upload' && this.musicSource != 'none') {
                        // Strip prefix if present (e.g. 'itunes_' or 'local_')
                        const cleanMusicId = String(this.musicId).split('_').pop();
                        formData.append('music_id', cleanMusicId);
                    }
                    if (this.musicSource) formData.append('music_source', this.musicSource);
                    if (this.musicStartTime) formData.append('music_start_time', this.musicStartTime);
                    if (this.parentId) formData.append('parent_id', this.parentId);
                    if (this.originalReelId) formData.append('original_reel_id', this.originalReelId);
                    
                    // Add Volumes for Server-side Mixing
                    formData.append('music_volume', this.musicVolume);
                    formData.append('mic_volume', this.micVolume);
                    
                    if (this.musicSource == 'global' && this.globalMusic) {
                        formData.append('global_music_url', this.globalMusic.url);
                        formData.append('global_music_title', this.globalMusic.title);
                        formData.append('global_music_artist', this.globalMusic.artist);
                        formData.append('global_music_thumbnail', this.globalMusic.thumbnail);
                    }
                    
                    if (this.musicSource == 'original' && this.originalAudioUrl) {
                        formData.append('global_music_url', this.originalAudioUrl);
                        formData.append('global_music_title', this.originalAudioTitle || 'Original Audio');
                    }
                    
                    if (this.musicSource == 'upload') {
                        if (this.uploadedMusicFile) {
                            formData.append('music_file', this.uploadedMusicFile);
                        } else {
                            const musicInput = document.querySelector('input[name="music_file"]');
                            if (musicInput && musicInput.files.length > 0) {
                                formData.append('music_file', musicInput.files[0]);
                            }
                        }
                        const audioNameInput = document.querySelector('input[name="audio_name"]');
                        if (audioNameInput && audioNameInput.value) {
                            formData.append('audio_name', audioNameInput.value);
                        }
                    }
                    
                    const prepRes = await fetch("{{ route('reels.prepare_upload') }}", {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': '{{ csrf_token() }}',
                            'Accept': 'application/json'
                        },
                        body: formData
                    });
                    
                    const prepData = await prepRes.json();
                    if(!prepData.success) {
                        if(window.Swal) Swal.close();
                        throw new Error(prepData.message || 'Failed to prepare upload');
                    }

                    // 2. Upload reel file to server (server forwards to BunnyCDN)
                    const file = this.videoFile;
                    const uploadFormData = new FormData();
                    uploadFormData.append('video', file);
                    uploadFormData.append('reel_id', prepData.reel_id);

                    const xhr = new XMLHttpRequest();
                    xhr.open('POST', '{{ route("reels.direct_upload") }}');
                    xhr.setRequestHeader('X-CSRF-TOKEN', '{{ csrf_token() }}');
                    xhr.setRequestHeader('Accept', 'application/json');

                    // Track upload progress (browser → server)
                    xhr.upload.onprogress = (e) => {
                        if (e.lengthComputable) {
                            this.progress = (e.loaded / e.total * 100);
                            const progressPercent = Math.round(this.progress);
                            const swalPopup = Swal.getPopup();
                            if (swalPopup) {
                                const swalText = swalPopup.querySelector('p');
                                if (swalText) {
                                    swalText.innerText = `Uploading reel... (${progressPercent}%)`;
                                }
                            }
                        }
                    };

                    xhr.onload = async () => {
                        if (xhr.status === 200) {
                            const result = JSON.parse(xhr.responseText);
                            if (result.success) {
                                // Upload thumbnail if exists (from file input OR camera capture)
                                const thumbInput = document.querySelector('input[name="thumbnail"]');
                                const thumbFile = (thumbInput && thumbInput.files[0]) ? thumbInput.files[0] : this.thumbnailFile;
                                if (thumbFile) {
                                    try {
                                        const swalText = document.querySelector('.swal2-html-container p');
                                        if (swalText) swalText.innerText = 'Uploading thumbnail...';

                                        const thumbData = new FormData();
                                        thumbData.append('thumbnail', thumbFile);
                                        const thumbRes = await fetch(`/reels/${prepData.reel_slug}/thumbnail`, {
                                            method: 'POST',
                                            headers: {
                                                'X-CSRF-TOKEN': '{{ csrf_token() }}',
                                                'Accept': 'application/json'
                                            },
                                            body: thumbData
                                        });
                                        const thumbResult = await thumbRes.json();
                                        if (!thumbResult.success) {
                                            console.error('Thumbnail upload failed:', thumbResult);
                                            notify('warning', 'Reel uploaded but thumbnail failed. You can add it from Studio.');
                                        }
                                    } catch (thumbErr) {
                                        console.error('Thumbnail upload error:', thumbErr);
                                        notify('warning', 'Reel uploaded but thumbnail failed. You can add it from Studio.');
                                    }
                                }

                                this.uploading = false;
                                if (isDraft) {
                                    notify('success', 'Reel saved as draft successfully.');
                                } else {
                                    notify('success', 'Reel uploaded successfully and is now processing.');
                                }
                                window.location.href = "{{ route('studio.dashboard') }}";
                            } else {
                                if(window.Swal) Swal.close();
                                notify('error', result.message || 'Upload failed');
                                this.uploading = false;
                            }
                        } else {
                            if(window.Swal) Swal.close();
                            notify('error', 'Upload failed. Server returned status: ' + xhr.status);
                            this.uploading = false;
                        }
                    };

                    xhr.onerror = () => {
                        console.error('Upload XHR error');
                        if(window.Swal) Swal.close();
                        notify('error', 'Upload failed due to a network error. Please try again.');
                        this.uploading = false;
                    };

                    xhr.send(uploadFormData);

                } catch (error) {
                    console.error(error);
                    notify('error', 'An error occurred during upload. Please try again.');
                    this.uploading = false;
                }
            }
        }));
    });
    // Defensive script to hide site header ONLY ON MOBILE for this page
    document.addEventListener('DOMContentLoaded', () => {
        if (window.innerWidth < 1024) {
            const header = document.getElementById('navigation-header');
            if (header) header.style.display = 'none';
            
            const sidebar = document.querySelector('aside');
            if (sidebar) sidebar.style.display = 'none';
        }
    });
</script>

{{-- SVG Filter Definitions for Free Effects --}}
<svg style="display: none;">
    <defs>
        <!-- VHS Filter -->
        <filter id="vhs-filter">
            <feTurbulence type="fractalNoise" baseFrequency="0.01 0.4" numOctaves="1" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="2" />
            <feColorMatrix type="saturate" values="1.2" />
        </filter>

        <!-- Glitch Filter -->
        <filter id="glitch-filter">
            <feTurbulence type="fractalNoise" baseFrequency="0.05 0.5" numOctaves="2" result="glitch-noise">
                <animate attributeName="baseFrequency" values="0.05 0.5; 0.1 0.8; 0.05 0.5" dur="0.2s" repeatCount="indefinite" />
            </feTurbulence>
            <feDisplacementMap in="SourceGraphic" in2="glitch-noise" scale="8" />
        </filter>

        <!-- RGB Split -->
        <filter id="rgb-split">
            <feOffset in="SourceGraphic" dx="4" dy="0" result="red" />
            <feOffset in="SourceGraphic" dx="-4" dy="0" result="blue" />
            <feComposite in="red" in2="blue" operator="arithmetic" k1="0" k2="1" k3="1" k4="0" />
        </filter>

        <!-- Prism Filter -->
        <filter id="prism-filter">
            <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="blur" />
            <feSpecularLighting surfaceScale="5" specularConstant="1" specularExponent="20" lighting-color="#ffffff">
                <fePointLight x="50" y="50" z="200" />
            </fePointLight>
            <feComposite in2="SourceGraphic" operator="in" />
        </filter>
    </defs>
</svg>
@endsection
